# Copy to .env.local (git-ignored) for LOCAL DEVELOPMENT ONLY, then run: python sugar_api.py
# Real credentials belong in .env.local or Settings -> LLM providers / Platform credentials.
# Never commit real keys. Values are redacted from logs, activity events, exports and diagnostic reports.
#
# SUGAR_LLM_API_KEY=            # used when a provider profile has no saved credential (e.g. an OpenAI API key)
# SUGAR_X_BEARER_TOKEN=         # X (Twitter) API bearer token
# SUGAR_MASTODON_TOKEN=
# SUGAR_BLUESKY_IDENTIFIER=
# SUGAR_BLUESKY_APP_PASSWORD=
# SUGAR_WEIBO_COOKIE=
# SUGAR_CRED_PROVIDER_MAIN=     # credential for provider profile id "main" (SUGAR_CRED_<REF>)
